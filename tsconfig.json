{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "@data/*": ["src/data/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@pom/*": ["src/pom/*"],
      "@utils/*": ["src/utils/*"]
    }
  }
}